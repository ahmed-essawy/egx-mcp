{
  "name": "egx-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "egx",
      "database_id": "795e9797-99a0-4a01-9a6d-a5a79721221a",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "DATA", "id": "2997b30bb1dc4829ad2ecf78715ef1b8" },
    { "binding": "OAUTH_KV", "id": "730c6805604c4bb882cf978d7cbb41a7" }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["* 6-13 * * SUN-THU", "30 12,13,14 * * SUN-THU", "0 16 * * *", "0 1 * * SAT"]
  },
  "vars": {
    "GLOBAL_DAILY_CALLS": "15000",
    "GLOBAL_DAILY_ROWS_READ": "3500000",
    "OAUTH_DAILY_KV_WRITES": "600",
    "USER_DAILY_CALLS": "100",
    "STOCK_PROVIDERS": "tradingview,mubasher",
    "SNAPSHOT_EVERY_MINUTES": "1",
    "BACKFILL_MAX_ROWS_PER_DAY": "36000",
    "ADJUST_MAX_ROWS_PER_DAY": "10000",
    "ADJUST_MAX_ACTIONS_PER_RUN": "2",
    "PERSONAL_DAILY_ROWS": "5000",
    "PUBLIC_ORIGIN": "https://egx-mcp.essawy.workers.dev",
    "GOOGLE_CLIENT_ID": "948374712014-itaqit8nkav80ene7ce700hj10rrov7k.apps.googleusercontent.com"
  }
}
